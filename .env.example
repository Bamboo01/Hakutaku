# Copy to `.env` next to whichever compose file you're using. Docker Compose
# reads it automatically. Note this file is read by Compose only -- `dotnet
# watch` on the host uses server/appsettings.Development.json instead.

# --- compose.dev.yaml (local only) ---
# Everything below is commented out because the defaults already work.

# Uncomment and edit to point the API at an external database. Add
# `SSL Mode=Require` when the traffic leaves the machine.
# DB_CONNECTION=Host=db.example.com;Database=hakutaku;Username=hakutaku;Password=xxx;SSL Mode=Require

# --- compose.yaml (production) ---
# Both required -- there are no defaults for these, unlike compose.dev.yaml.

# Real domain pointing at this host's public IP (DNS A record must already
# resolve before Caddy starts, so it can complete the ACME challenge).
# HAKUTAKU_DOMAIN=backend.example.com

# openssl rand -base64 32
# POSTGRES_PASSWORD=xxx

# There is no docs variable to set: compose derives the wiki's hostname as
# docs.${HAKUTAKU_DOMAIN}, and nip.io resolves any prefix to the same IP.

# Password for the first owner account (username "admin"). Read only on first start,
# while the database has no admins. If unset, the app generates one and prints it
# once in its log: docker logs hakutaku-app-1
# HAKUTAKU_ADMIN_PASSWORD=xxx
